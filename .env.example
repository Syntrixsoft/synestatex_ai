JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# OTP
OTP_LENGTH=6
OTP_EXPIRY_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_SECONDS=60

# MSG91 (SMS) — used later; console print for now
MSG91_AUTH_KEY=
MSG91_SENDER_ID=
