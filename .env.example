EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
DEFAULT_FROM_EMAIL=noreply@synestatex.ai
EMAIL_REPLY_TO=
EMAIL_DEFAULT_SUBJECT=Notification
